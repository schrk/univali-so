alice@mfs:/home/alice$ # 3.1 - Estrutura de diretórios em árvore, mkdir e cd
alice@mfs:/home/alice$ pwd
/home/alice
alice@mfs:/home/alice$ mkdir projetos
alice@mfs:/home/alice$ mkdir -p projetos/so/m3
alice@mfs:/home/alice$ mkdir projetos
mkdir: projetos: arquivo já existe
alice@mfs:/home/alice$ cd projetos/so
alice@mfs:/home/alice/projetos/so$ pwd
/home/alice/projetos/so
alice@mfs:/home/alice/projetos/so$ cd ..
alice@mfs:/home/alice/projetos$ pwd
/home/alice/projetos
alice@mfs:/home/alice/projetos$ cd ../..
alice@mfs:/home$ pwd
/home
alice@mfs:/home$ cd /home/alice/projetos/so/m3
alice@mfs:/home/alice/projetos/so/m3$ pwd
/home/alice/projetos/so/m3
alice@mfs:/home/alice/projetos/so/m3$ cd
alice@mfs:/home/alice$ pwd
/home/alice

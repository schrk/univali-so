alice@mfs:/home/alice$ # Bônus: hard links (vários nomes, um inode) e diferença entre cp, mv e ln
alice@mfs:/home/alice$ echo "dados compartilhados" > original
alice@mfs:/home/alice$ ln original link1
alice@mfs:/home/alice$ mkdir outra
alice@mfs:/home/alice$ ln original outra/link2
alice@mfs:/home/alice$ ls -li original link1 outra/link2
  7 -rw-r--r--  3 alice  dev           21 2025-11-19 14:00 original
  7 -rw-r--r--  3 alice  dev           21 2025-11-19 14:00 link1
  7 -rw-r--r--  3 alice  dev           21 2025-11-19 14:00 link2
alice@mfs:/home/alice$ ls -li outra/link2
  7 -rw-r--r--  3 alice  dev           21 2025-11-19 14:00 link2
alice@mfs:/home/alice$ stat link1
  Arquivo: link1
  Inode: 7      Links: 3    Tipo: texto
  Tamanho: 21    Blocos: 1   (bloco = 64 bytes)
  Acesso: (0644/-rw-r--r--)  Uid: (1000/alice)  Gid: (100/dev)
  Criado:     2025-11-19 14:00:00
  Modificado: 2025-11-19 14:00:00
  Acessado:   2025-11-19 14:00:00
  Diretos: [0 -1 -1 -1 -1 -1 -1 -1]  Indireto: -1
alice@mfs:/home/alice$ echo "alterado pelo link" > outra/link2
alice@mfs:/home/alice$ cat original
alterado pelo link
alice@mfs:/home/alice$ cp original copia
alice@mfs:/home/alice$ mv link1 movido
alice@mfs:/home/alice$ ls -li
  9 -rw-r--r--  1 alice  dev           19 2025-11-19 14:00 copia
  7 -rw-r--r--  3 alice  dev           19 2025-11-19 14:00 movido
  7 -rw-r--r--  3 alice  dev           19 2025-11-19 14:00 original
  8 drwxr-xr-x  2 alice  dev            0 2025-11-19 14:00 outra/
alice@mfs:/home/alice$ df
Disco simulado: 256 blocos de 64 bytes (16384 bytes)
Usados: 2  Livres: 254  Uso: 0%  Inodes em uso: 9
Mapa de bits (. livre  # dados  I índice):
  000 ##..............................................................
  064 ................................................................
  128 ................................................................
  192 ................................................................
alice@mfs:/home/alice$ rm original
alice@mfs:/home/alice$ cat movido
alterado pelo link
alice@mfs:/home/alice$ stat movido
  Arquivo: movido
  Inode: 7      Links: 2    Tipo: texto
  Tamanho: 19    Blocos: 1   (bloco = 64 bytes)
  Acesso: (0644/-rw-r--r--)  Uid: (1000/alice)  Gid: (100/dev)
  Criado:     2025-11-19 14:00:00
  Modificado: 2025-11-19 14:00:00
  Acessado:   2025-11-19 14:00:00
  Diretos: [0 -1 -1 -1 -1 -1 -1 -1]  Indireto: -1
alice@mfs:/home/alice$ rm movido
alice@mfs:/home/alice$ rm outra/link2
alice@mfs:/home/alice$ stat copia
  Arquivo: copia
  Inode: 9      Links: 1    Tipo: texto
  Tamanho: 19    Blocos: 1   (bloco = 64 bytes)
  Acesso: (0644/-rw-r--r--)  Uid: (1000/alice)  Gid: (100/dev)
  Criado:     2025-11-19 14:00:00
  Modificado: 2025-11-19 14:00:00
  Acessado:   2025-11-19 14:00:00
  Diretos: [1 -1 -1 -1 -1 -1 -1 -1]  Indireto: -1
alice@mfs:/home/alice$ inodes
  id  tipo        links  tamanho  blocos  dono
  1   diretório       1        0       0  root
  2   diretório       1        0       0  root
  3   diretório       1        0       0  alice
  4   diretório       1        0       0  bob
  5   diretório       1        0       0  carol
  6   diretório       1        0       0  root
  8   diretório       1        0       0  alice
  9   texto           1       19       1  alice
alice@mfs:/home/alice$ df
Disco simulado: 256 blocos de 64 bytes (16384 bytes)
Usados: 1  Livres: 255  Uso: 0%  Inodes em uso: 8
Mapa de bits (. livre  # dados  I índice):

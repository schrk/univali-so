alice@mfs:/home/alice$ # 3.3 - Permissões RWX para dono, grupo e outros (alice e bob: grupo dev; carol: visitantes)
alice@mfs:/home/alice$ id
uid=1000(alice) gid=100(dev)
alice@mfs:/home/alice$ echo "segredo" > nota.txt
alice@mfs:/home/alice$ ls -l nota.txt
-rw-r--r--  1 alice  dev            8 2025-11-19 14:00 nota.txt
alice@mfs:/home/alice$ chmod 640 nota.txt
alice@mfs:/home/alice$ ls -l nota.txt
-rw-r-----  1 alice  dev            8 2025-11-19 14:00 nota.txt
alice@mfs:/home/alice$ su bob
bob@mfs:/home/alice$ id
uid=1001(bob) gid=100(dev)
bob@mfs:/home/alice$ cat /home/alice/nota.txt
segredo
bob@mfs:/home/alice$ echo "bob escreveu" >> /home/alice/nota.txt
echo: /home/alice/nota.txt: permissão negada
bob@mfs:/home/alice$ chmod 777 /home/alice/nota.txt
chmod: /home/alice/nota.txt: operação não permitida
bob@mfs:/home/alice$ su carol
carol@mfs:/home/alice$ cat /home/alice/nota.txt
cat: /home/alice/nota.txt: permissão negada
carol@mfs:/home/alice$ su alice
alice@mfs:/home/alice$ chmod g+w,o+r nota.txt
alice@mfs:/home/alice$ ls -l nota.txt
-rw-rw-r--  1 alice  dev            8 2025-11-19 14:00 nota.txt
alice@mfs:/home/alice$ su bob
bob@mfs:/home/alice$ echo "bob escreveu" >> /home/alice/nota.txt
bob@mfs:/home/alice$ su carol
carol@mfs:/home/alice$ cat /home/alice/nota.txt
segredo
bob escreveu
carol@mfs:/home/alice$ # o dono usa SÓ os bits de dono, mesmo que outros tenham mais
carol@mfs:/home/alice$ su alice
alice@mfs:/home/alice$ chmod 077 nota.txt
alice@mfs:/home/alice$ cat nota.txt
cat: nota.txt: permissão negada
alice@mfs:/home/alice$ chmod u=rw nota.txt
alice@mfs:/home/alice$ cat nota.txt
segredo
bob escreveu
alice@mfs:/home/alice$ # diretórios: r = listar, w = criar/apagar nomes, x = atravessar
alice@mfs:/home/alice$ mkdir privado
alice@mfs:/home/alice$ echo "x" > privado/arq
alice@mfs:/home/alice$ chmod 700 privado
alice@mfs:/home/alice$ su bob
bob@mfs:/home/alice$ ls /home/alice/privado
ls: /home/alice/privado: permissão negada
bob@mfs:/home/alice$ cat /home/alice/privado/arq
cat: /home/alice/privado/arq: permissão negada
bob@mfs:/home/alice$ cd /home/alice/privado
cd: /home/alice/privado: permissão negada
bob@mfs:/home/alice$ su alice
alice@mfs:/home/alice$ chmod 711 privado
alice@mfs:/home/alice$ su bob
bob@mfs:/home/alice$ ls /home/alice/privado
ls: /home/alice/privado: permissão negada
bob@mfs:/home/alice$ cat /home/alice/privado/arq
x
bob@mfs:/home/alice$ touch /home/alice/privado/novo
touch: /home/alice/privado/novo: permissão negada
bob@mfs:/home/alice$ # apagar depende do diretório, não do arquivo
bob@mfs:/home/alice$ touch /tmp/do_bob
bob@mfs:/home/alice$ chmod 000 /tmp/do_bob
bob@mfs:/home/alice$ rm /tmp/do_bob
bob@mfs:/home/alice$ # execução
bob@mfs:/home/alice$ su alice
alice@mfs:/home/alice$ echo -e "#!mfs\necho executou como:\nwhoami" > script
alice@mfs:/home/alice$ ./script
exec: ./script: permissão negada
alice@mfs:/home/alice$ chmod u+x script
alice@mfs:/home/alice$ ./script
executou como:
alice
alice@mfs:/home/alice$ su bob
bob@mfs:/home/alice$ ./script
exec: ./script: permissão negada
bob@mfs:/home/alice$ cd /home/alice
bob@mfs:/home/alice$ exec script
exec: script: permissão negada
bob@mfs:/home/alice$ su alice
alice@mfs:/home/alice$ chmod 755 script
alice@mfs:/home/alice$ su bob
bob@mfs:/home/alice$ exec script
executou como:
bob
bob@mfs:/home/alice$ # root: ignora r/w, mas só executa se houver algum bit x
bob@mfs:/home/alice$ su root
root@mfs:/home/alice# chmod 600 /home/alice/script
root@mfs:/home/alice# cat /home/alice/script
#!mfs
echo executou como:
whoami
root@mfs:/home/alice# exec /home/alice/script
exec: /home/alice/script: permissão negada
root@mfs:/home/alice# chown carol:visitantes /home/alice/script
root@mfs:/home/alice# ls -l /home/alice/script
-rw-------  1 carol  visitantes    33 2025-11-19 14:00 script
root@mfs:/home/alice# su alice
alice@mfs:/home/alice$ chown alice /home/alice/script
chown: /home/alice/script: operação não permitida
alice@mfs:/home/alice$ chmod 777 /home/alice/script
chmod: /home/alice/script: operação não permitida
alice@mfs:/home/alice$ # umask
alice@mfs:/home/alice$ umask
0022
alice@mfs:/home/alice$ umask 027
alice@mfs:/home/alice$ touch novo
alice@mfs:/home/alice$ mkdir novodir
alice@mfs:/home/alice$ ls -l novo novodir
-rw-r-----  1 alice  dev            0 2025-11-19 14:00 novo

novodir:
alice@mfs:/home/alice$ ls -l
-rw-rwxrwx  1 alice  dev           21 2025-11-19 14:00 nota.txt
-rw-r-----  1 alice  dev            0 2025-11-19 14:00 novo
drwxr-x---  2 alice  dev            0 2025-11-19 14:00 novodir/
drwx--x--x  2 alice  dev            0 2025-11-19 14:00 privado/
-rw-------  1 carol  visitantes    33 2025-11-19 14:00 script
alice@mfs:/home/alice$ 
